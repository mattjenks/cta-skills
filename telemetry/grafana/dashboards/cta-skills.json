{
  "uid": "cta-skills",
  "title": "CTA Skills",
  "tags": [
    "cta"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Skill invocations by skill and trigger",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "cta-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cta-loki"
          },
          "expr": "sum by (skill_name, invocation_trigger) (count_over_time({service_name=\"claude-code\"} | event_name=\"skill_activated\" | skill_name=~\"$skill\" [$__auto]))",
          "legendFormat": "{{skill_name}} / {{invocation_trigger}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Invocations in range (red = zero)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "cta-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cta-loki"
          },
          "expr": "sum(count_over_time({service_name=\"claude-code\"} | event_name=\"skill_activated\" | skill_name=\"$installed\" [$__range])) or vector(0)",
          "legendFormat": "$installed",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 4
      },
      "repeat": "installed",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "$installed",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Tool duration p50 / p95 (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "cta-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cta-loki"
          },
          "expr": "quantile_over_time(0.5, {service_name=\"claude-code\"} | event_name=\"tool_result\" | unwrap duration_ms [$__auto]) by (tool_name)",
          "legendFormat": "p50 {{tool_name}}",
          "refId": "A",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "cta-loki"
          },
          "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name=\"tool_result\" | unwrap duration_ms [$__auto]) by (tool_name)",
          "legendFormat": "p95 {{tool_name}}",
          "refId": "B",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Skill episode duration p50 / p95 (ms, range)",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "cta-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cta-loki"
          },
          "expr": "quantile_over_time(0.5, {service_name=\"claude-code\"} | event_name=\"cta.skill_episode\" | skill=~\"$skill\" | unwrap duration_ms [$__range]) by (skill)",
          "legendFormat": "p50 {{skill}}",
          "refId": "A",
          "queryType": "instant"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "cta-loki"
          },
          "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name=\"cta.skill_episode\" | skill=~\"$skill\" | unwrap duration_ms [$__range]) by (skill)",
          "legendFormat": "p95 {{skill}}",
          "refId": "B",
          "queryType": "instant"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "title": "Tool failures",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "cta-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cta-loki"
          },
          "expr": "sum by (tool_name) (count_over_time({service_name=\"claude-code\"} | event_name=\"tool_result\" | success=\"false\" [$__auto]))",
          "legendFormat": "{{tool_name}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Outcomes by skill (episodes, range)",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "cta-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cta-loki"
          },
          "expr": "sum by (skill, outcome) (count_over_time({service_name=\"claude-code\"} | event_name=\"cta.skill_episode\" | skill=~\"$skill\" [$__range]))",
          "legendFormat": "{{skill}} / {{outcome}}",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Cost by skill (USD, range)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "cta-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cta-prom"
          },
          "expr": "sum by (skill_name) (max_over_time(claude_code_cost_usage_USD_total{skill_name=~\"$skill\"}[$__range]))",
          "legendFormat": "{{skill_name}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "description": "Claude Code exports one cumulative series per session, often with a single sample, so increase() returns nothing; this sums each session's maximum within the range."
    },
    {
      "id": 6,
      "title": "Tokens by skill and type (range)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "cta-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cta-prom"
          },
          "expr": "sum by (skill_name, type) (max_over_time(claude_code_token_usage_tokens_total{skill_name=~\"$skill\"}[$__range]))",
          "legendFormat": "{{skill_name}} / {{type}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Claude Code exports one cumulative series per session, often with a single sample, so increase() returns nothing; this sums each session's maximum within the range."
    },
    {
      "id": 8,
      "title": "Drift signals (episodes with signals)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "cta-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cta-loki"
          },
          "expr": "{service_name=\"claude-code\"} | event_name=\"cta.skill_episode\" | signals!=\"\" | signals!=\"none\" | skill=~\"$skill\"",
          "legendFormat": "",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 9,
      "title": "Sessions per day",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "cta-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cta-loki"
          },
          "expr": "count(sum by (session_id) (count_over_time({service_name=\"claude-code\"} | event_name=\"user_prompt\" [1d])))",
          "legendFormat": "sessions",
          "refId": "A",
          "queryType": "range",
          "interval": "1d"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Builds per week",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "cta-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cta-loki"
          },
          "expr": "sum by (size) (count_over_time({service_name=~\".+\"} | event_name=\"cta.build\" [1w]))",
          "legendFormat": "{{size}}",
          "refId": "A",
          "queryType": "range",
          "step": "1d"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Fix rounds per build",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "cta-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cta-loki"
          },
          "expr": "avg(avg_over_time({service_name=~\".+\"} | event_name=\"cta.build\" | unwrap fix_rounds [1w]))",
          "legendFormat": "avg",
          "refId": "A",
          "queryType": "range",
          "step": "1d"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "cta-loki"
          },
          "expr": "max(max_over_time({service_name=~\".+\"} | event_name=\"cta.build\" | unwrap fix_rounds [1w]))",
          "legendFormat": "max",
          "refId": "B",
          "queryType": "range",
          "step": "1d"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Learn decisions by type (range)",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "cta-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cta-loki"
          },
          "expr": "sum by (decision) (count_over_time({service_name=~\".+\"} | event_name=\"cta.learn.decision\" [$__range]))",
          "legendFormat": "{{decision}}",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "skill",
        "label": "Skill",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cta-prom"
        },
        "query": {
          "query": "label_values(claude_code_cost_usage_USD_total, skill_name)",
          "refId": "v"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "installed",
        "label": "Installed skills",
        "type": "custom",
        "query": "core:create-skill,core:create-hook,core:config-audit",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  }
}
